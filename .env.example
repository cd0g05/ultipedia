# Copy to .env and fill in. NEVER commit the real .env.
# The backend reads these from the environment (backend/app/config.py).

# --- Supabase (required for real persistence) ---
# Project settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Project settings → API → service_role secret. SERVER-SIDE ONLY. Never ship to the browser.
SUPABASE_SERVICE_KEY=your-service-role-key

# Only needed to run migrations via `python -m backend.app.db.migrate`.
# Project settings → Database → Connection string → URI.
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- Backend tuning (optional; sensible defaults in config.py) ---
# ULTI_MAX_FIELD_LEN=8000
# ULTI_MAX_PAYLOAD_BYTES=131072
# ULTI_RATE_LIMIT_PER_MINUTE=20
# ULTI_HONEYPOT_FIELD=website
# Comma-separated origins allowed to call the API (your deployed frontend URL).
ULTI_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (Vite) — set in frontend/.env.local, prefixed VITE_ ---
# VITE_PLAUSIBLE_DOMAIN=ultipedia.example.com
